generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(ACTIVE)
  timezone    String             @default("America/Chicago")
  language    String             @default("en-US")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  users       User[]
  roles       Role[]
  auditLogs   AuditLog[]
  socialAccounts SocialAccount[]
  mediaAssets    MediaAsset[]
  socialPosts    SocialPost[]
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  name         String
  email        String
  passwordHash String
  status       UserStatus   @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles        UserRole[]
  sessions     UserSession[]
  auditLogs    AuditLog[]
  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users          UserRole[]
  permissions    RolePermission[]
  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedBy String?  @db.Uuid
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserSession {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  tokenHash String        @unique
  status    SessionStatus @default(ACTIVE)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
  @@index([expiresAt])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  entityType     String
  entityId       String?
  action         String
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  correlationId  String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}


enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  PINTEREST
}

enum SocialAccountStatus {
  PENDING
  CONNECTED
  EXPIRED
  ERROR
  DISCONNECTED
}

model SocialAccount {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @db.Uuid
  platform              SocialPlatform
  accountName           String
  handle                String?
  externalAccountId     String?
  profileUrl            String?
  status                SocialAccountStatus @default(PENDING)
  accessTokenCiphertext String?
  refreshTokenCiphertext String?
  tokenExpiresAt        DateTime?
  scopes                String[]            @default([])
  lastVerifiedAt        DateTime?
  lastRefreshAttemptAt  DateTime?
  lastRefreshAt         DateTime?
  refreshLeaseUntil     DateTime?
  lastError             String?
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postTargets           SocialPostTarget[]

  @@index([organizationId, status])
  @@index([organizationId, platform])
  @@unique([organizationId, platform, externalAccountId])
}


model SocialOAuthState {
  id             String         @id @default(uuid()) @db.Uuid
  stateHash      String         @unique
  platform       SocialPlatform
  organizationId String         @db.Uuid
  userId         String         @db.Uuid
  codeVerifier   String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([expiresAt])
  @@index([organizationId, platform])
}


enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

model SocialPost {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  createdById    String           @db.Uuid
  title          String
  body           String           @db.Text
  status         SocialPostStatus @default(DRAFT)
  scheduledAt    DateTime?
  submittedAt    DateTime?
  approvedAt     DateTime?
  approvedById   String?          @db.Uuid
  publishedAt    DateTime?
  lastError      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targets        SocialPostTarget[]
  approvals      SocialPostApproval[]
  media          SocialPostMedia[]
  @@index([organizationId, status, scheduledAt])
  @@index([organizationId, createdAt])
}

model SocialPostTarget {
  id             String       @id @default(uuid()) @db.Uuid
  postId         String       @db.Uuid
  socialAccountId String      @db.Uuid
  platformStatus String       @default("PENDING")
  providerPostId String?
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  post           SocialPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount  SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  publishJob     PublishJob?
  @@unique([postId, socialAccountId])
  @@index([socialAccountId])
}

model SocialPostApproval {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @db.Uuid
  reviewerId  String   @db.Uuid
  decision    String
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  post        SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
}


enum PublishJobStatus {
  QUEUED
  PROCESSING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

model PublishJob {
  id             String          @id @default(uuid()) @db.Uuid
  targetId       String          @unique @db.Uuid
  organizationId String          @db.Uuid
  status         PublishJobStatus @default(QUEUED)
  attempts       Int             @default(0)
  maxAttempts    Int             @default(5)
  nextAttemptAt  DateTime        @default(now())
  leaseUntil     DateTime?
  providerPostId String?
  lastError      String?         @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  target         SocialPostTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
}


model MediaAsset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  uploadedById   String   @db.Uuid
  fileName       String
  mimeType       String
  sizeBytes      Int
  storagePath    String   @unique
  altText        String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postLinks      SocialPostMedia[]
  @@index([organizationId, createdAt])
}

model SocialPostMedia {
  postId      String @db.Uuid
  mediaAssetId String @db.Uuid
  sortOrder   Int @default(0)
  post        SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  @@id([postId, mediaAssetId])
  @@index([mediaAssetId])
}
